PORT=5000
NODE_ENV=development

# Gemini API Key (Insert your Google AI Studio API key)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Optional - defaults to high-fidelity JSON persistence)
MONGODB_URI=mongodb://localhost:27017/awaazgram

# Firebase Config (Optional)
FIREBASE_PROJECT_ID=awaazgram-sih
FIREBASE_STORAGE_BUCKET=awaazgram-sih.appspot.com
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
